datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid()) @map("_id")
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  profile           Profile?
  savedJobs         SavedJob[]
  applications      Application[]
  resumeAnalyses    ResumeAnalysis[]
  interviewSessions InterviewSession[]
}

model Profile {
  id                            String    @id @default(uuid()) @map("_id")
  userId                        String    @unique
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                          String
  phone                         String?   @default("")
  headline                      String?   @default("")
  targetRole                    String?   @default("Senior Frontend Engineer")
  preferredLocations            String[]  @default(["Bengaluru", "Hyderabad", "Remote (India)"])
  minSalaryLpa                  Float     @default(0)
  experienceYears               Int       @default(0)
  skills                        String[]  @default([])
  resumeText                    String?
  lastResumeUploadDate          DateTime?
  profileCompletenessPercentage Int       @default(20)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
}

model Job {
  id               String        @id @map("_id")
  title            String
  company          String
  companyTagline   String?
  location         String
  experienceLevel  String
  jobType          String
  category         String
  salaryMinLpa     Float
  salaryMaxLpa     Float
  postedDate       String
  skills           String[]      @default([])
  description      String
  requirements     String[]      @default([])
  responsibilities String[]      @default([])
  benefits         String[]      @default([])
  isFeatured       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  savedByUsers     SavedJob[]
  applications     Application[]
}

model SavedJob {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id            String    @id @default(uuid()) @map("_id")
  userId        String
  jobId         String
  stage         String    @default("saved")
  notes         String?
  interviewDate DateTime?
  matchScore    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model ResumeAnalysis {
  id                 String   @id @default(uuid()) @map("_id")
  userId             String
  fileName           String?
  overallScore       Int
  sectionScores      Json
  strengths          String[] @default([])
  weaknesses         String[] @default([])
  suggestions        String[] @default([])
  missingSkills      String[] @default([])
  matchedSkills      String[] @default([])
  extractedWordCount Int      @default(0)
  detectedRoleTarget String   @default("Full Stack Engineer")
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id               String   @id @default(uuid()) @map("_id")
  userId           String
  questionId       String
  question         String
  role             String
  difficulty       String
  category         String
  userAnswer       String
  timeSpentSeconds Int      @default(0)
  feedback         Json
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
